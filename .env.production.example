# =============================================================================
# Production .env template for drfit-app-be on the VPS.
# Copy to `.env` next to docker-compose.prod.yml and fill in the secrets.
# =============================================================================

# --- Postgres (used by docker-compose.prod.yml to provision the DB) ---------
POSTGRES_USER=drfit
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=drfit

# --- App --------------------------------------------------------------------
# DATABASE_URL is overridden by docker-compose to point at the `db` service,
# but keep a sensible default here too.
DATABASE_URL=postgresql://drfit:CHANGE_ME_STRONG_PASSWORD@db:5432/drfit

JWT_SECRET=CHANGE_ME_RANDOM_64_HEX
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=30

# Stripe (fill in real keys)
STRIPE_SECRET_KEY=sk_live_or_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Legacy admin secret used by POST /slots from the mobile/admin app
ADMIN_SECRET=CHANGE_ME_ADMIN_SECRET

PORT=3000
CANCELLATION_POLICY_HOURS=2
CANCELLATION_REFUND_PERCENT=100

# CORS
ADMIN_DASHBOARD_ORIGIN=https://drfit.admin.hacktrack.fun
MOBILE_ORIGIN=*

# Public base URL used to build absolute URLs (e.g. avatar URLs).
PUBLIC_BASE_URL=https://drfit.api.hacktrack.fun
# Where to store uploaded files inside the container (mounted as a volume).
UPLOADS_DIR=/app/uploads
